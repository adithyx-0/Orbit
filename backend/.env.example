# =============================================
#  SubOptima AI — Backend Environment Variables
#  Copy this file to .env and fill in your values
#  NEVER commit .env to git
# =============================================

# Supabase PostgreSQL connection string
# Get from: Supabase → Project Settings → Database → URI
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# JWT secret — use any long random string (min 32 chars)
JWT_SECRET=replace_this_with_a_long_random_secret_string_min_32_chars

# Server port
PORT=5000

# Node environment
NODE_ENV=development
