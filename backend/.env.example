# =============================================
#  SubOptima AI — Backend Environment Variables
#  Copy this file to .env and fill in your values
#  NEVER commit .env to git
# =============================================

# Supabase PostgreSQL connection string
# Get from: Supabase → Project Settings → Database → URI
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.igxeygauhfxqnudkcjne.supabase.co:5432/postgres

# JWT secret — use any long random string (min 32 chars)
JWT_SECRET=replace_this_with_a_long_random_secret_string_min_32_chars

# Server port
PORT=5000

# Node environment
NODE_ENV=development

# Set to true when connecting to Supabase or any cloud Postgres that requires SSL.
# Leave unset or false for a plain local PostgreSQL install.
DB_SSL=true

# Google Gemini API key — used by the AI chat endpoint (/api/chat)
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
