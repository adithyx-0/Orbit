# PROSIT Windows Agent — copy this to .env and fill in your values

# Backend API base URL (no trailing slash)
API_URL=http://localhost:5000/api

# Your PROSIT account credentials
USER_EMAIL=your@email.com
USER_PASSWORD=yourpassword

# How often to flush usage data to the server (in minutes)
UPLOAD_INTERVAL_MINUTES=60

# How often to check the active window (in seconds, default 5)
POLL_INTERVAL_SECONDS=5
